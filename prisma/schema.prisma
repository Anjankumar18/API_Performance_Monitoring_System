generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiMetric {
  id          String   @id @default(uuid())
  method      String
  path        String
  statusCode  Int
  durationMs  Int
  isError     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([statusCode])
  @@index([createdAt])
}
